generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── AI / RAG Models ───────────────────────────────────────────────────────────

model Document {
  id        String                 @id @default(uuid())
  content   String
  embedding Unsupported("vector")?
}

model langchain_pg_collection {
  uuid                   String                   @id @db.Uuid
  name                   String                   @unique @db.VarChar
  cmetadata              Json?                    @db.Json
  langchain_pg_embedding langchain_pg_embedding[]
}

model langchain_pg_embedding {
  id                      String                   @id @db.VarChar
  collection_id           String?                  @db.Uuid
  embedding               Unsupported("vector")?
  document                String?                  @db.VarChar
  cmetadata               Json?
  langchain_pg_collection langchain_pg_collection? @relation(fields: [collection_id], references: [uuid], onDelete: Cascade, onUpdate: NoAction)

  @@index([cmetadata(ops: JsonbPathOps)], map: "ix_cmetadata_gin", type: Gin)
}

// ─── Core Business Models ──────────────────────────────────────────────────────

enum ProjectStage {
  LEAD_CAPTURED
  SURVEY_SCHEDULED
  SURVEY_COMPLETED
  PO_SIGNED
  INVOICED
  INC_IN_PROGRESS
  PLANT_INSTALLED
  DOC_SUBMITTED
  DOC_VERIFIED
  METER_SEALING
  DCR_FILED
  INST_DETAIL_SUBMITTED
  PCR_FILED
  SUBSIDY_REDEEMED
  CLOSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EmployeeRole {
  ADMIN
  MANAGER
  SALESPERSON
  TECHNICIAN
  OFFICE_STAFF
}

enum NotificationType {
  TASK_ASSIGNED
  STAGE_CHANGED
  APPROVAL_REQUIRED
  TASK_OVERDUE
  DISCOM_UPDATE
  GENERAL
}

model Employee {
  id            String         @id @default(uuid())
  password      String?        // Hashed password
  name          String
  email         String?
  phone         String?
  role          EmployeeRole   @default(TECHNICIAN)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  assignedTasks TaskAssignment[]
  activities    ActivityLog[]     @relation("ActivityByEmployee")
  projectsSold  Project[]         @relation("SoldByEmployee")
  notifications Notification[]
  schedule      EmployeeSchedule?
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  callingNo     String?
  mobile        String?
  email         String?
  caNumber      String?
  division      String?
  location      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  projects      Project[]
  discomIssues  DiscomIssue[]
}

model Project {
  id               String        @id @default(uuid())
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Sales Info
  capacity         Float?
  sourceOfLead     String?
  brandModel       String?
  referral         String?
  soldById         String?
  soldByEmployee   Employee?     @relation("SoldByEmployee", fields: [soldById], references: [id])

  // Financial
  amount           Float?
  balance          Float?

  // Pipeline Stage
  stage            ProjectStage  @default(LEAD_CAPTURED)
  surveyStatus     String?
  poSigned         String?
  invoiceDate      DateTime?
  incStage         String?
  plantStatus      String?

  // Documentation & Net Metering
  docSubmitted     String?
  documentStatus   String?
  meterTypeSl      String?
  status           String?
  sealingIndent    String?
  dcr              String?
  instDetailSub    String?
  pcr              String?
  subsidyRedeem    String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  tasks            TaskAssignment[]
  activities       ActivityLog[]
  netMeterFiles    NetMeterFile[]
}

model TaskAssignment {
  id            String        @id @default(uuid())
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedToId  String
  assignedTo    Employee      @relation(fields: [assignedToId], references: [id])

  title         String
  description   String?
  status        TaskStatus    @default(PENDING)
  priority      TaskPriority  @default(MEDIUM)
  dueDate       DateTime?
  completedAt   DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ActivityLog {
  id            String    @id @default(uuid())
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId    String?
  employee      Employee? @relation("ActivityByEmployee", fields: [employeeId], references: [id])

  action        String        // e.g. "STAGE_CHANGED", "TASK_COMPLETED", "NOTE_ADDED"
  description   String
  oldValue      String?
  newValue      String?
  metadata      Json?

  createdAt     DateTime  @default(now())
}

model DiscomIssue {
  id            String    @id @default(uuid())
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date          DateTime?
  customerName  String?
  caNumber      String?
  division      String?
  mobile        String?
  issueDesc     String?
  remark        String?
  status        String?   @default("OPEN")
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model EmployeeSchedule {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  employee     Employee @relation(fields: [employeeId], references: [id])
  monday       String?
  tuesday      String?
  wednesday    String?
  thursday     String?
  friday       String?
  saturday     String?
  sunday       String?
}

model NetMeterFile {
  id            String    @id @default(uuid())
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerName  String?
  mobile        String?
  email         String?
  fileStatus    String?   @default("PENDING")  // PENDING, SENT, APPROVED, REJECTED
  source        String?   // "RNE" or "RIL_NE"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id            String           @id @default(uuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id])
  type          NotificationType @default(GENERAL)
  title         String
  message       String
  isRead        Boolean          @default(false)
  actionUrl     String?
  createdAt     DateTime         @default(now())
}
