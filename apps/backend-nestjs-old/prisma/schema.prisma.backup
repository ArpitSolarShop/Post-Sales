// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Document {
  id        String                 @id @default(uuid())
  content   String
  embedding Unsupported("vector(1536)")?
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  mobile        String?
  caNumber      String?
  division      String?
  location      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  projects      Project[]
  discomIssues  DiscomIssue[]
}

model Project {
  id               String    @id @default(uuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  capacity         Float?
  sourceOfLead     String?
  brandModel       String?
  referral         String?
  surveyStatus     String?
  amount           Float?
  balance          Float?
  poSigned         String?
  soldBy           String?
  invoiceDate      DateTime?
  incStage         String?
  plantStatus      String?
  docSubmitted     String?
  documentStatus   String?
  meterTypeSl      String?
  status           String?
  sealingIndent    String?
  dcr              String?
  instDetailSub    String?
  pcr              String?
  subsidyRedeem    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model DiscomIssue {
  id            String    @id @default(uuid())
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date          DateTime?
  customerName  String?   // Denormalized for issues without linked accounts
  caNumber      String?
  division      String?
  mobile        String?
  issueDesc     String?
  remark        String?
  status        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model EmployeeSchedule {
  id          String   @id @default(uuid())
  employeeName String
  monday      String?
  tuesday     String?
  wednesday   String?
  thursday    String?
  friday      String?
  saturday    String?
  sunday      String?
}
